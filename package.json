{
  "name": "cricdotcric-x-tg-automation",
  "version": "1.0.0",
  "private": true,
  "description": "An autonomous cricket-tweeting agent: headless Claude drafts, a human approves over Telegram, a real-time bot posts to X. Runs locally via macOS launchd.",
  "keywords": [
    "llm-agent",
    "claude",
    "automation",
    "twitter",
    "x-api",
    "telegram-bot",
    "human-in-the-loop",
    "launchd",
    "cricket"
  ],
  "author": "Haryy Venky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haryyvenky/cricdotcric-X-TG-automation.git"
  },
  "type": "commonjs",
  "scripts": {
    "verify": "node scripts/x-post.js --account cricdotcric --verify",
    "post:due:dry": "node scripts/post-queue.js queue.json --dry-run",
    "post:due": "node scripts/post-queue.js queue.json",
    "tg:selftest": "node scripts/telegram.js selftest",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
