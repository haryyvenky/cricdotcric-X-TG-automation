<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cricdotcric.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/haryyvenky/cricdotcric-X-TG-automation/scripts/telegram-bot.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/haryyvenky/cricdotcric-X-TG-automation</string>
  <!-- Always-on: start at login and restart if it ever exits (real-time replies). -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/haryyvenky/cricdotcric-X-TG-automation/state/logs/bot.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/haryyvenky/cricdotcric-X-TG-automation/state/logs/bot.err</string>
</dict>
</plist>
